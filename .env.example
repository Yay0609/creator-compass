# =========================================================
# 创作罗盘 — 环境变量样例
# 用法：Copy-Item .env.example .env 后按说明填写
# 注意：.env 不入库；空值会触发校验失败（这是刻意设计，用于尽早暴露配置问题）
# =========================================================

# ---------- 数据库 ----------
# 开发：SQLite 文件（相对 prisma 目录）；生产：Postgres 连接串（Neon / Supabase 使用带 -pooler / pgbouncer 的地址）
DATABASE_URL="file:./dev.db"

# ---------- 会话 ----------
# 会话签名密钥，至少 32 个字符。生成命令：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ---------- AI（OpenAI 兼容接口，仅服务端使用） ----------
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ---------- 配额与防刷 ----------
# 单用户每日 AI 调用总上限
AI_DAILY_LIMIT="20"
# 每月各功能生成额度
QUOTA_TOPIC="10"
QUOTA_SCRIPT="10"
QUOTA_REVIEW="5"

# ---------- 应用 ----------
APP_BASE_URL="http://localhost:3000"