# =========================================================
# 创作罗盘 — 环境变量样例
# 用法：Copy-Item .env.example .env 后按说明填写
# 注意：.env 不入库；空值会触发校验失败（这是刻意设计，用于尽早暴露配置问题）
# =========================================================

# ---------- 数据库 ----------
# 开发：SQLite 文件（相对 prisma 目录）；生产：Postgres 连接串（Neon / Supabase 使用带 -pooler / pgbouncer 的地址）
DATABASE_URL="file:./dev.db"

# ---------- 会话 ----------
# 会话签名密钥，至少 32 个字符。生成命令：
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ---------- AI（OpenAI 兼容接口，仅服务端使用） ----------
# 没有真实 Key 时，可先用仓库内置的 mock 上游跑通链路（P2/P3/P4 通用）：
#   1) node scripts/mock-openai.mjs                          # 另开一个终端
#   2) OPENAI_BASE_URL="http://127.0.0.1:4010/v1"
#   3) OPENAI_API_KEY 保持任意非空占位值即可（本地 mock 不校验）
# 部署前必须换成真实 Key，并把 BASE_URL 改回真实地址。
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ---------- 配额与防刷 ----------
# 单用户每日 AI 调用总上限（全局防刷，所有功能共用）
AI_DAILY_LIMIT="20"
# 每月各功能生成额度
QUOTA_TOPIC="10"
QUOTA_SCRIPT="10"
QUOTA_REVIEW="5"

# ---------- 应用 ----------
APP_BASE_URL="http://localhost:3000"