# =========================================================
# 创作罗盘 — 环境变量样例
# 用法：Copy-Item .env.example .env 后按说明填写
# 注意：.env 不入库；必填项为空会触发校验失败（这是刻意设计，用于尽早暴露配置问题）
# =========================================================

# ---------- 数据库 ----------
# 开发：SQLite 文件（相对 prisma 目录）；生产：Postgres 连接串（Neon / Supabase 使用带 -pooler / pgbouncer 的地址）
DATABASE_URL="file:./dev.db"

# ---------- 会话 ----------
# 会话签名密钥，至少 32 个字符。生成命令：
# node -e "console.log(require(""crypto"").randomBytes(32).toString(""hex""))"
SESSION_SECRET=""

# ---------- AI（OpenAI 兼容接口，仅服务端使用） ----------
# 没有真实 Key 时，可先用仓库内置的 mock 上游跑通链路（P2/P3/P4/P5 通用）：
#   1) node scripts/mock-openai.mjs                          # 另开一个终端
#   2) OPENAI_BASE_URL="http://127.0.0.1:4010/v1"
#   3) OPENAI_API_KEY 保持任意非空占位值即可（本地 mock 不校验）
# 部署前必须换成真实 Key，并把 BASE_URL 改回真实地址。
# 填好真实 Key 后，可用全链路真实冒烟脚本自检：corepack pnpm smoke:real
# 上游二选一（都是 OpenAI 兼容接口）：
#   DeepSeek（P5 起默认目标）：BASE_URL=https://api.deepseek.com/v1 / MODEL=deepseek-chat
#   OpenAI：                    BASE_URL=https://api.openai.com/v1 / MODEL=gpt-4o-mini
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_MODEL="deepseek-chat"

# ---------- AI 限额（P5 起可调；留空即使用默认值） ----------
# 单次请求 max_tokens 上限：默认 3000，允许 1-8192
AI_MAX_TOKENS="3000"
# 单次请求硬超时（毫秒）：默认 45000，允许 5000-120000
AI_TIMEOUT_MS="45000"
# AiCallLog 保留天数：默认 90，清理脚本只删除早于该天数的日志
AI_LOG_RETENTION_DAYS="90"

# ---------- 配额与防刷 ----------
# 单用户每日 AI 调用总上限（全局防刷，所有功能共用）
AI_DAILY_LIMIT="20"
# 每月各功能生成额度
QUOTA_TOPIC="10"
QUOTA_SCRIPT="10"
QUOTA_REVIEW="5"

# ---------- 应用 ----------
APP_BASE_URL="http://localhost:3000"

# ---------- 生产部署（P6，本地开发无需填写） ----------
# DIRECT_URL：仅生产（Postgres）需要。Neon 的直连地址，供 prisma migrate deploy 使用；
#             本地 SQLite 不读这个变量，留空不影响开发。
DIRECT_URL=""
# CRON_SECRET：Vercel Cron 调用 /api/cron/prune-ai-logs 的 Bearer 密钥。
#              生产必填（不填则该接口拒绝执行），任意随机长串即可。
CRON_SECRET=""
# Sentry：本轮未接入，留空即可；后续接入时再补 SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN。
